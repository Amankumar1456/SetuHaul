# Claude (Anthropic)
ANTHROPIC_API_KEY=<your_key>
# Google Gemini (optional — we can use this as a fallback or for specific tasks)
GOOGLE_API_KEY=<your_key>
# LangSmith (for tracing — very useful for learning, you can see every agent step)
LANGCHAIN_TRACING_V2=<your_key>LANGCHAIN_API_KEY=<your_key>LANGSMITH_PROJECT=<your_key>LANGSMITH_ENDPOINT=<your_key>
# Supabase
SUPABASE_URL=<your_key>SUPABASE_KEY=<your_key>

# Redis
REDIS_URL=<your_key>
OPENROUTER_API_KEY=<your_key>
OPENROUTER_MODEL=<your_key>
GROQ_API_KEY=<your_key>

